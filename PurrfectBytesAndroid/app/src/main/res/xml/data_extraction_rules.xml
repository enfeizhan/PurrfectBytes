<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Everything is backed up except the YouTube sign-in:
     its refresh token gives full access to the channel and must stay on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="youtube_auth_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="youtube_auth_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
